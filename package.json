{
  "name": "hackaton-aprova",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do agente de implantação da Aprova: coleta requisitos via chat e preenche o formulário de implantação.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "kb:validate": "tsx scripts/validate-kb.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
