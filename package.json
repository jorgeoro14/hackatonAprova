{
  "name": "hackaton-aprova",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do agente de implantação da Aprova: coleta requisitos via chat e preenche o formulário de implantação.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "kb:validate": "tsx scripts/validate-kb.ts",
    "kb:importar-leis": "tsx scripts/importar-legislacao.ts",
    "chat": "tsx scripts/chat.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7",
    "gray-matter": "^4.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
