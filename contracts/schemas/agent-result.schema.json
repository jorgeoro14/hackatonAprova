{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assistant_reply",
    "form",
    "missing_fields"
  ],
  "properties": {
    "assistant_reply": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "form": {
      "$ref": "form.schema.json"
    },
    "missing_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "municipality",
          "process_name",
          "objective",
          "department",
          "owner_role",
          "trigger",
          "steps",
          "expected_output"
        ]
      }
    }
  }
}
