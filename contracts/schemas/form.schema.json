{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "form",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "municipality",
    "process_name",
    "objective",
    "department",
    "owner_role",
    "trigger",
    "inputs",
    "steps",
    "business_rules",
    "exceptions",
    "current_systems",
    "integration_needs",
    "expected_output"
  ],
  "properties": {
    "municipality": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "process_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "department": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_role": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "trigger": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "responsible_role"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "responsible_role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "current_systems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "integration_needs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "expected_output": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "x-required-for-review": [
    "municipality",
    "process_name",
    "objective",
    "department",
    "owner_role",
    "trigger",
    "steps",
    "expected_output"
  ],
  "description": "Provisional implementation form. All fields are present even in a draft. Null and empty collections preserve unknowns. Review requires non-null nonblank scalar values from x-required-for-review and at least one valid step."
}
