{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "role",
    "text",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "enum": [
        "employee",
        "assistant"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
