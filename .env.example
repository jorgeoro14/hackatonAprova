# Illustrative names; document the selected stack before implementing.
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000/api/v1
# Server only. Never expose model credentials in frontend variables.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-6-luna
OPENAI_API_KEY=
# Optional legacy override; leave blank to use OPENAI_API_KEY.
MODEL_API_KEY=
# Optional municipal RAG. An explicit embedding model must match the saved index.
EMBEDDING_MODEL=
# Server only; falls back to MODEL_API_KEY, then OPENAI_API_KEY. Explicit embedding/query only.
EMBEDDING_API_KEY=
# Optional Phase 3 answer judge; used only with both --live and --judge.
EVAL_MODEL_NAME=
# Initial agent CLI requires MODEL_PROVIDER=openai and an explicit tool-capable MODEL_NAME.
# Optional server-side tracing; enable only deliberately with synthetic sessions.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=aprova-process-agent
# Select and document the storage implementation before setting this.
DATABASE_URL=

# Existing TypeScript knowledge API settings.
PORT=3333
KNOWLEDGE_DIR=knowledge
# Reserved for the TypeScript chat adapter; independent of the Python agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional live requirements Studio graph. Empty profile means pending verification.
REQUIREMENTS_CAPABILITIES_PATH=
REQUIREMENTS_ALLOW_SYNTHETIC=false

PORT=3333
# Pasta raiz da base de conhecimento (relativa à raiz do projeto)
KNOWLEDGE_DIR=knowledge

# serviço do agente Python (agents/app/server.py)
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT_MS=60000
# pasta dos anexos do chat
UPLOAD_DIR=uploads

# PostgreSQL (Supabase). No painel: Connect → Session pooler → URI (troque [YOUR-PASSWORD]).
# Use o session pooler (porta 5432) ou a conexão direta; o transaction pooler (6543) não serve para servidor de longa duração.
JWT_SECRET=troque-este-segredo-em-producao
JWT_VALIDADE_MINUTOS=480
# Origens do front (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Senha dos usuários de demo (head, maria.silva, joao.pereira, ana.costa)
SEED_SENHA=aprova123
