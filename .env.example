PORT=3333
# Pasta raiz da base de conhecimento (relativa à raiz do projeto)
KNOWLEDGE_DIR=knowledge

# serviço do agente Python (agents/app/server.py)
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT_MS=60000
# pasta dos anexos do chat
UPLOAD_DIR=uploads

# PostgreSQL (Supabase). No painel: Connect → Session pooler → URI (troque [YOUR-PASSWORD]).
# Use o session pooler (porta 5432) ou a conexão direta; o transaction pooler (6543) não serve para servidor de longa duração.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
JWT_SECRET=troque-este-segredo-em-producao
JWT_VALIDADE_MINUTOS=480
# Origens do front (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Senha dos usuários de demo (head, maria.silva, joao.pereira, ana.costa)
SEED_SENHA=aprova123
