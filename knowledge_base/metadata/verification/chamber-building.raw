<script>
        $(".popup_sic_status_close").on('click', function (e) {
            $("#popup_sic_status_wrapper").trigger('click');
            //$("#popup-atribuicoes").hide();
        });
        $(".popup_sic_consulta_close").on('click', function (e) {
            $("#popup_sic_consulta_wrapper").trigger('click');
            //$("#popup-atribuicoes").hide();
        });
        $(".popup_sic_recurso_close").on('click', function (e) {
            $("#popup_sic_recurso_wrapper").trigger('click');
            //$("#popup-atribuicoes").hide();
        });
        $(".btn-close-popup").on('click', function (e) {
            $("#popup-atribuicoes_wrapper").trigger('click');
            //$("#popup-atribuicoes").hide();
        });

        $(".atribuicoes-cargo-vereador").on('click', function (e) {
            e.preventDefault();
            
            $("#popup-atribuicoes-foto").attr("data-src","");
            $("#popup-atribuicoes-foto").attr("src","");
            $("#popup-atribuicoes-titulo").html("");
            $("#popup-atribuicoes-descricao").html("");
            
            var link    = $(this).data('vereador-link');
            var cargo   = $(this).data('vereador-cargo');
            var nome    = $(this).data('vereador-nome');
            var foto    = $(this).data('vereador-foto');
            var partido = $(this).data('vereador-partido');
            
            if(cargo === "Presidente")
            {
                var atribuicoes = ""+
                    "<p style='text-align:justify'>Al&eacute;m de ter prefer&ecirc;ncia na substitui&ccedil;&atilde;o ao prefeito, no caso de vac&acirc;ncia, aus&ecirc;ncia ou impedimento do vice-prefeito, o presidente tamb&eacute;m &eacute; o respons&aacute;vel por representar o Legislativo oficialmente e fazer a gest&atilde;o da Casa.</p>"+
                    "<p style='text-align:justify'>Quem ocupa a Presid&ecirc;ncia da CMC comanda as sess&otilde;es plen&aacute;rias, sendo o respons&aacute;vel por abri-las, presidi-las, suspend&ecirc;-las e encerr&aacute;-las; manter a ordem, interpretar e fazer cumprir o Regimento Interno; conceder a palavra aos vereadores e a outros convidados e interromper o orador que se desviar do assunto em debate, podendo cassar a palavra; organizar a ordem do dia da sess&atilde;o seguinte (projetos de lei que entrar&atilde;o na pauta de vota&ccedil;&otilde;es); e convocar sess&otilde;es ordin&aacute;rias, extraordin&aacute;rias e solenes.</p>"+
                    "<p style='text-align:justify'>Ainda em rela&ccedil;&atilde;o ao processo legislativo, o presidente possui prerrogativa de promulgar leis, o que ocorre quando o prefeito deixa de promulgar ou sancionar uma lei - a chamada san&ccedil;&atilde;o t&aacute;cita. A promulga&ccedil;&atilde;o &eacute; o ato que declara a exist&ecirc;ncia da norma e ordena sua execu&ccedil;&atilde;o. Devido a essas atribui&ccedil;&otilde;es, o presidente &eacute; o &uacute;nico com remunera&ccedil;&atilde;o maior que os demais vereadores.</p>"+
                    "<p style='text-align:justify'>O presidente tamb&eacute;m indica os integrantes das comiss&otilde;es permanentes e tempor&aacute;rias, zela pelo prest&iacute;gio e decoro da C&acirc;mara, ordena as despesas do Legislativo, deve apresentar mensalmente o balancete da C&acirc;mara do m&ecirc;s anterior, administra o pessoal da C&acirc;mara e atribui aos servidores do Legislativo vantagens legalmente autorizadas bem como determina a apura&ccedil;&atilde;o de responsabilidade administrativa, civil e criminal de servidores. Al&eacute;m disso, pode exercer atos de pol&iacute;cia em quaisquer mat&eacute;rias relacionadas com as atividades da C&acirc;mara.</p>"+
                    "<p style='text-align:justify'>O Presidente n&atilde;o tem direito a voto a menos que haja empate em qualquer vota&ccedil;&atilde;o simb&oacute;lica ou nominal durantes as sess&otilde;es e na vota&ccedil;&atilde;o de cassa&ccedil;&atilde;o de mandato de Vereador, Prefeito ou Vice-Prefeito.</p>"+
                "";
            }
            else
            if((cargo === "1º Vice-Presidente") || (cargo === "2º Vice-Presidente"))
            {
                var atribuicoes = ""+
                    "<p style='text-align:justify'>Os vice-presidentes do Legislativo têm a função de substituir o presidente em suas ausências ou impedimentos. Eles também devem promulgar leis, caso o presidente deixe de fazê-lo, e, assim como os demais membros da Mesa Diretora, estão na linha sucessória do prefeito.</p>"+
                "";
            }
            else
            if((cargo === "1º Secretário") || (cargo === "2º Secretário"))
            {
                var atribuicoes = ""+
                    "<p style='text-align:justify'>O primeiro-secretários substitui os vice-presidentes em suas ausências ou impedimentos, auxiliam o presidente nos trabalhos da sessão, no controle da presença dos vereadores, na inscrição para debates, na leitura de projetos etc.</p>"+
                    "<p style='text-align:justify'>O segundo-secretários substitui os vice-presidentes em suas ausências ou impedimentos, auxiliam o presidente nos trabalhos da sessão, no controle da presença dos vereadores, na inscrição para debates, na leitura de projetos etc.</p>"+
                "";
            }
            
            
            
            $("#popup-atribuicoes-foto").attr("data-src",foto);
            $("#popup-atribuicoes-foto").attr("src",foto);
            
            $("#popup-atribuicoes-titulo").html(cargo);
            $("#popup-atribuicoes-descricao").html(atribuicoes);
            
			$("#popup-atribuicoes").popup({
				autoopen: true,
			});
            
            //$("").show();
            //$(".modal-").html();
            
            
            
            
            //alert(link + cargo + nome + foto + partido);
        });
        
