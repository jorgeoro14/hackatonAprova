        <script type="text/javascript">
jQuery(document).ready(function () {
    //CORRESPONDENCIA
    $('#manifestante-resposta-correspondencia-estado').change(function(e){
        $("#manifestante-resposta-correspondencia-cidade").html("<option value=''>Carregando...</option>");
         
        $.getJSON('https://www.camaracascavel.pr.gov.br/json/cidades.php?CodEstado='+$('#manifestante-resposta-correspondencia-estado').val(),
        function (estados){
            var options_cidades = "<option value=''></option>";
            var str = "";
            $("#manifestante-resposta-correspondencia-estado option:selected").each(function () {
                    str += $(this).val();
            });
            $.each(estados, function (index, estado) {
                if(estado[0]['codestado'] == str)
                {
                    $.each(estado[0]['cidades'], function (index, cidade) {
                        options_cidades += '<option id="codcidadeOption' + cidade['codcidade'] + '" value="' + cidade['codcidade'] + '">' + cidade['nome'] + '</option>';
                    });							
                }
            });
            //$("#codcidade").text("Selecione");
            $('.TextRetornoManifestacao').html("<p></p>");
        });
    });
    
    //MANIFESTANTE
    $('#manifestante-estado').change(function(e){
        $("#manifestante-cidade").html("<option value=''>Carregando...</option>");
         
        $.getJSON('https://www.camaracascavel.pr.gov.br/json/cidades.php?CodEstado='+$('#manifestante-estado').val(),
        function (estados){
            var options_cidades = "<option value=''></option>";
            var str = "";
            $("#manifestante-estado option:selected").each(function () {
                    str += $(this).val();
            });
            $.each(estados, function (index, estado) {
                if(estado[0]['codestado'] == str)
                {
                    $.each(estado[0]['cidades'], function (index, cidade) {
                        options_cidades += '<option id="codcidadeOption' + cidade['codcidade'] + '" value="' + cidade['codcidade'] + '">' + cidade['nome'] + '</option>';
                    });							
                }
            });
            //$("#codcidade").text("Selecione");
            $('#manifestante-cidade').html(options_cidades);
        });
    });
    
    $('#idestado').change(function(e){
        $("#idcidade").html("<option value=''>Carregando...</option>");
        
        var data = {limit:0,idestado:$('#idestado').val()};
         
        $.post("https://sistemas.webmes.com.br/api/sistema/parametros/cidades", data, 
        function (cidades){
            var options_cidades = "<option value=''></option>";
            var str = "";
            $("#idestado option:selected").each(function () {
                    str += $(this).val();
            });
            $.each(cidades.results, function (index, cidade) {
                
                options_cidades += '<option id="'+cidade["id"]+'" value="'+cidade["id"]+'">'+cidade["nome"]+'</option>';
                /*
                if(estado[0]['codestado'] == str)
                {
                    $.each(estado[0]['cidades'], function (index, cidade) {
                        options_cidades += '<option id="codcidadeOption' + cidade['codcidade'] + '" value="' + cidade['codcidade'] + '">' + cidade['nome'] + '</option>';
                    });							
                }
                */
            });
            //$("#codcidade").text("Selecione");
            $('#idcidade').html(options_cidades);
        },'json');
    });
});
</script>        <script>
            jQuery(document).ready(function () {
                            });
        </script>

